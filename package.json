{
  "name": "alpar-ai",
  "version": "1.1.0",
  "private": true,
  "description": "ALPAR AI — Trust infrastructure for AI accountability. Community-driven incident reporting platform.",
  "license": "AGPL-3.0",
  "author": "ALPAR AI Team",
  "homepage": "https://alparai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantummatrixcore-lab/Alparai.com.git"
  },
  "keywords": [
    "ai",
    "incident",
    "reporting",
    "trust",
    "safety",
    "accountability",
    "transparency"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n \"DEV,TEST,OPENCODE\" -c \"cyan,magenta,green\" \"pnpm dev\" \"pnpm test:watch\" \"opencode\"",
    "build": "node scripts/check-i18n.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y/",
    "test:visual": "playwright test tests/e2e/visual/",
    "knip": "knip",
    "validate": "pnpm i18n:check && pnpm typecheck && pnpm lint && pnpm test",
    "db:seed": "npx tsx scripts/seed-roadmap.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.36",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@google/generative-ai": "^0.24.1",
    "@marsidev/react-turnstile": "^1.5.3",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.47",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "google-news-url-decoder": "^1.2.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.3",
    "openai": "^6.48.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pnpm": "^11.11.0",
    "puppeteer-core": "^25.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.27.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
