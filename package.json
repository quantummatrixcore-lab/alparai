{
  "name": "alparai",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "description": "ALPAR AI — Trust infrastructure for AI accountability. Community-driven incident reporting platform.",
  "license": "AGPL-3.0",
  "author": "ALPAR AI Team",
  "homepage": "https://alparai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantummatrixcore-lab/alparai.git"
  },
  "keywords": [
    "ai",
    "incident",
    "reporting",
    "trust",
    "safety",
    "accountability",
    "transparency"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "turbo run dev test:watch",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node scripts/guardian.js && cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next build --webpack",
    "start": "next start",
    "lint": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit",
    "i18n:check": "node scripts/sync-i18n.js",
    "i18n:sync": "node scripts/sync-i18n.js",
    "i18n:measure": "node scripts/measure-translation-completeness.js",
    "check:links": "node scripts/route-checker.js",
    "check:routes": "node scripts/route-checker.js",
    "check:hygiene": "npx tsx scripts/codebase-hygiene.ts",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --pool=forks",
    "test:watch": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vitest",
    "test:coverage": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y/",
    "test:visual": "playwright test tests/e2e/visual/",
    "knip": "knip",
    "validate": "turbo run typecheck lint test i18n:check",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:seed": "npx tsx scripts/seed-roadmap.ts",
    "db:seed:incidents": "npx tsx scripts/seed-real-incidents.ts",
    "prepare": "husky",
    "hooks:install": "bash scripts/install-hooks.sh",
    "briefing": "npx tsx scripts/morning-briefing.ts",
    "guard": "node scripts/guardian.js",
    "precommit": "node scripts/guardian.js && npx vitest run tests/contracts/translation-integrity.test.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.70",
    "@ai-sdk/openai": "4.0.53",
    "@ai-sdk/provider-utils": "5.0.25",
    "@ai-sdk/react": "4.0.90",
    "@ai-sdk/ui-utils": "1.2.11",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@google/generative-ai": "0.24.1",
    "@marsidev/react-turnstile": "1.5.3",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/nextjs": "10.69.0",
    "@stripe/stripe-js": "9.13.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.9.3",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.87",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "12.42.2",
    "google-news-url-decoder": "1.2.2",
    "googleapis": "174.0.1",
    "imap-simple": "^5.1.0",
    "ioredis": "6.0.0",
    "lucide-react": "0.577.0",
    "mailparser": "^3.9.19",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.0",
    "openai": "6.48.0",
    "papaparse": "5.5.4",
    "posthog-js": "1.413.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "simple-icons": "16.28.0",
    "sonner": "2.0.7",
    "stripe": "22.3.2",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "2.1.8",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  },
  "resolutions": {
    "esbuild@<=0.24.2": ">=0.25.0",
    "vite@>=5.0.0 <=5.4.11": ">=5.4.12",
    "vite@>=5.0.0 <5.4.15": ">=5.4.15",
    "vite@>=5.0.0 <5.4.18": ">=5.4.18",
    "vite@>=5.0.0 <=5.4.18": ">=5.4.19",
    "vite@>=5.0.0 <5.4.17": ">=5.4.17",
    "vite@<=5.4.19": ">=5.4.20",
    "vite@>=5.2.6 <=5.4.20": ">=5.4.21",
    "vite@>=5.0.0 <5.4.16": ">=5.4.16",
    "vite@<=6.4.1": ">=6.4.2",
    "vite@<=6.4.2": ">=6.4.3",
    "vitest@<3.2.6": ">=3.2.6",
    "postcss": ">=8.5.23",
    "@ai-sdk/provider-utils": ">=5.0.26",
    "semver": ">=5.7.2",
    "sharp": ">=0.35.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@>=5.0.0 <=5.4.11": ">=5.4.12",
      "vite@>=5.0.0 <5.4.15": ">=5.4.15",
      "vite@>=5.0.0 <5.4.18": ">=5.4.18",
      "vite@>=5.0.0 <=5.4.18": ">=5.4.19",
      "vite@>=5.0.0 <5.4.17": ">=5.4.17",
      "vite@<=5.4.19": ">=5.4.20",
      "vite@>=5.2.6 <=5.4.20": ">=5.4.21",
      "vite@>=5.0.0 <5.4.16": ">=5.4.16",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@<=6.4.2": ">=6.4.3",
      "vitest@<3.2.6": ">=3.2.6",
      "postcss": ">=8.5.23",
      "@ai-sdk/provider-utils": ">=5.0.26",
      "semver": ">=5.7.2",
      "sharp": ">=0.35.3"
    }
  }
}
