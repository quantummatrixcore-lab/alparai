# =============================================================================
# ALPAR AI — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# Application
NEXT_PUBLIC_APP_NAME="ALPAR AI"
NEXT_PUBLIC_APP_URL="https://alparai.com"
NEXT_PUBLIC_APP_DESCRIPTION="Trust infrastructure for AI accountability"
NODE_ENV="development"

# Locales (comma-separated, first is default)
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,tr"

# Supabase — Public (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL="https://auth.alparai.com"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth / Authentication
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email routing & Unsubscribe
LEGAL_EMAIL="legal@alparai.com"
PRIVACY_EMAIL="privacy@alparai.com"
TAKEDOWN_EMAIL="takedown@alparai.com"
SUPPORT_EMAIL="support@alparai.com"
APP_TAKEDOWN_EMAIL="takedown@alparai.com"
UNSUBSCRIBE_SALT="replace-me-with-a-32-byte-random-string"

# Resend transactional email (server-only). When empty, contact form falls back
# to a structured log line so submissions are still observable in dev.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="ALPAR AI <noreply@alparai.com>"

# Salt for hashing client IPs before any logging or DB write.
# Generate with:  openssl rand -hex 32
# Treat as a secret. Rotate quarterly.
IP_SALT="replace-me-with-a-32-byte-random-string"

# Rate limiting (Upstash Redis — optional, recommended for production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Social / OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="341717447635-hsdu69hk692lkveikkpc8398v8rhu40b.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Error monitoring & Security
NEXT_PUBLIC_ENABLE_USER_SUGGESTIONS="true"
NEXT_PUBLIC_ENABLE_AI_PROVIDER_RESPONSES="true"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="your-turnstile-secret"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN="your-sentry-token"

# Autonomous Marketing Agents (Google Flow / Social Media)
GOOGLE_FLOW_API_KEY="your-google-flow-ultra-key"
GOOGLE_FLOW_PROJECT_ID="d54b8ce7-1279-4d80-9456-73ac4246fc8e"
LINKEDIN_API_KEY="your-linkedin-api-key"
X_API_KEY="your-x-api-key"
TIKTOK_API_KEY="your-tiktok-api-key"

# Sovereign ErcuOS & DeHost Internal AI Bridge
# On DeHost Dedicated Xeon: Internal Docker network communication (Zero external latency & 100% data sovereignty)
ERCUOS_API_URL="http://127.0.0.1:11434/v1"
ERCUOS_API_KEY="sovereign-internal-key"
AI_GATEWAY_URL="http://127.0.0.1:11434/v1"

# AI Provider API Keys & Fallbacks
NVIDIA_NGC_API_KEY="your-nvidia-ngc-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
HUGGINGFACE_API_KEY="your-huggingface-api-key"
BLACKBOX_API_KEY="your-blackbox-api-key"
PINECONE_API_KEY="your-pinecone-api-key"

# Google Jules AI Coding Agent
JULES_API_KEY="your_jules_api_key_from_jules_google_com_settings"

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Billing & Payments
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Security, Cron & Cloud
# Feed URLs for cron jobs (expected CSV shape: ID, Stream, Source category, Date, Year, Severity, CVSS, Attack vector, OWASP LLM, OWASP ASI, MITRE ATLAS, NIST AI RMF, CVE IDs, AIID ID, Mapped threats, Quality tier, Title, Affected, Primary reference URL, Description)
AIAAIC_FEED_URL=""
AIID_FEED_URL=""
CRON_SECRET="your-cron-secret-key"
CLOUDFLARE_API_TOKEN="your-cloudflare-token"
VERCEL_TOKEN="your-vercel-token"
VERCEL_OIDC_TOKEN="your-vercel-oidc-token"
GITHUB_TOKEN="your-github-token"

# Credentials & Integrations
GOOGLE_DRIVE_CREDENTIALS=""
GOOGLE_APPLICATION_CREDENTIALS=""