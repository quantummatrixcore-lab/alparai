{
  "name": "alpar-ai",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "description": "ALPAR AI — Trust infrastructure for AI accountability. Community-driven incident reporting platform.",
  "license": "AGPL-3.0",
  "author": "ALPAR AI Team",
  "homepage": "https://alparai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantummatrixcore-lab/alparai.git"
  },
  "keywords": [
    "ai",
    "incident",
    "reporting",
    "trust",
    "safety",
    "accountability",
    "transparency"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "turbo run dev test:watch",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" node scripts/guardian.js && cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" next build --webpack",
    "start": "next start",
    "lint": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" tsc --noEmit",
    "i18n:check": "node scripts/sync-i18n.js",
    "i18n:sync": "node scripts/sync-i18n.js",
    "i18n:measure": "node scripts/measure-translation-completeness.js",
    "check:links": "node scripts/route-checker.js",
    "check:routes": "node scripts/route-checker.js",
    "check:hygiene": "npx tsx scripts/codebase-hygiene.ts",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" vitest run --pool=forks",
    "test:watch": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" vitest",
    "test:coverage": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" vitest run --coverage",
    "test:jury": "node scripts/jury_redteam_drill.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y/",
    "test:visual": "playwright test tests/e2e/visual/",
    "knip": "knip",
    "validate": "turbo run typecheck lint test i18n:check",
    "db:reset": "dehost db reset",
    "db:migrate": "dehost migration up",
    "db:seed": "npx tsx scripts/seed-roadmap.ts",
    "db:seed:incidents": "npx tsx scripts/seed-real-incidents.ts",
    "prepare": "husky",
    "hooks:install": "bash scripts/install-hooks.sh",
    "briefing": "npx tsx scripts/morning-briefing.ts",
    "guard": "node scripts/guardian.js",
    "ship": "node scripts/deploy.mjs",
    "precommit": "node scripts/guardian.js && npx vitest run tests/contracts/translation-integrity.test.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.70",
    "@ai-sdk/openai": "4.0.53",
    "@ai-sdk/provider-utils": "5.0.25",
    "@ai-sdk/react": "4.0.90",
    "@ai-sdk/ui-utils": "1.2.11",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@google/generative-ai": "0.24.1",
    "@marsidev/react-turnstile": "1.5.3",
    "@phosphor-icons/react": "2.1.10",
    "@stripe/stripe-js": "9.13.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "ai": "7.0.87",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "12.42.2",
    "google-news-url-decoder": "1.2.2",
    "googleapis": "174.0.1",
    "ioredis": "6.0.0",
    "lucide-react": "0.577.0",
    "mailparser": "3.9.26",
    "next": "16.4.1",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "nodemailer": "10.1.1",
    "openai": "6.48.0",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "simple-icons": "16.28.0",
    "sonner": "2.0.7",
    "stripe": "22.3.2",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.1",
    "zod": "3.25.76",
    "posthog-js": "^1.144.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "3.2.6",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "9.1.7",
    "imap-simple": "5.1.0",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "13.0.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "ts-morph": "28.0.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  }
}