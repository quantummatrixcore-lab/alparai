#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running Alparai Pre-commit Guardian Checks..."
node scripts/guardian.js

if [ $? -ne 0 ]; then
  echo "🚨 Pre-commit checks failed! Commit aborted."
  exit 1
fi

echo "Running Edge Runtime Ban Verification..."
node scripts/check-no-edge-runtime.mjs

if [ $? -ne 0 ]; then
  echo "🚨 Edge runtime check failed! Commit aborted."
  exit 1
fi
