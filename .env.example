# =============================================================================
# ALPAR AI — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# Application
NEXT_PUBLIC_APP_NAME="ALPAR AI"
NEXT_PUBLIC_APP_URL="https://alparai.com"
NEXT_PUBLIC_APP_DESCRIPTION="Trust infrastructure for AI accountability"
NODE_ENV="development"

# Locales (comma-separated, first is default)
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,tr"

# Supabase — Public (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL="https://auth.alparai.com"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email routing (Cloudflare Email Routing or Resend)
LEGAL_EMAIL="legal@alparai.com"
PRIVACY_EMAIL="privacy@alparai.com"
TAKEDOWN_EMAIL="takedown@alparai.com"
SUPPORT_EMAIL="support@alparai.com"
APP_TAKEDOWN_EMAIL="takedown@alparai.com"

# Resend transactional email (server-only). When empty, contact form falls back
# to a structured log line so submissions are still observable in dev.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="ALPAR AI <noreply@alparai.com>"

# Salt for hashing client IPs before any logging or DB write.
# Generate with:  openssl rand -hex 32
# Treat as a secret. Rotate quarterly.
IP_SALT="replace-me-with-a-32-byte-random-string"

# Rate limiting (Upstash Redis — optional, recommended for production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Social / OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID="341717447635-hsdu69hk692lkveikkpc8398v8rhu40b.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Error monitoring (Sentry — optional)
NEXT_PUBLIC_ENABLE_USER_SUGGESTIONS="true"
NEXT_PUBLIC_ENABLE_AI_PROVIDER_RESPONSES="true"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Autonomous Marketing Agents (Google Flow / Social Media)
GOOGLE_FLOW_API_KEY="your-google-flow-ultra-key"
GOOGLE_FLOW_PROJECT_ID="d54b8ce7-1279-4d80-9456-73ac4246fc8e"
LINKEDIN_API_KEY="your-linkedin-api-key"
X_API_KEY="your-x-api-key"
TIKTOK_API_KEY="your-tiktok-api-key"

# AI Provider API Keys (NVIDIA NIM Free-Tier & Fallbacks)
NVIDIA_NGC_API_KEY="your-nvidia-ngc-api-key"


# Google Jules AI Coding Agent
JULES_API_KEY=your_jules_api_key_from_jules_google_com_settings

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

