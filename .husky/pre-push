#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[pre-push] Running quality checks before push..."
ONLY_DOCS=1
UNKNOWN_STATE=0
HAS_COMMITS=0

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  
  HAS_COMMITS=1

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch or remote ref doesn't exist. We are in doubt.
    UNKNOWN_STATE=1
    break
  fi

  # Get changed files
  CHANGED_FILES=$(git diff --name-only $remote_sha..$local_sha 2>/dev/null)
  if [ $? -ne 0 ]; then
    UNKNOWN_STATE=1
    break
  fi
  
  if [ -z "$CHANGED_FILES" ]; then
    continue
  fi

  for FILE in $CHANGED_FILES; do
    case "$FILE" in
      docs/*.md|*.md)
        # It's a markdown file
        ;;
      *)
        ONLY_DOCS=0
        break
        ;;
    esac
  done
done

if [ $HAS_COMMITS -eq 0 ]; then
  # No commits being pushed
  exit 0
fi

if [ $UNKNOWN_STATE -eq 1 ] || [ $ONLY_DOCS -eq 0 ]; then
  echo "[pre-push] Code changes detected (or state unknown). Running full test suite..."
  pnpm typecheck && pnpm lint && pnpm test
else
  echo "[pre-push] Only markdown/docs changes detected. Running document checks..."
  pnpm run check:masterplan-length && pnpm run check-plan
fi
