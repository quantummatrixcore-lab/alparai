# ==============================================================================
# AlparAI Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Lemon Squeezy Monetization & Webhook Triggers
# ------------------------------------------------------------------------------
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# ------------------------------------------------------------------------------
# Polar.sh Monetization & API Pass Configuration
# ------------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_ORGANIZATION_ID=your_polar_organization_id_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here


# ------------------------------------------------------------------------------
# Core Application & Auth Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_random_nextauth_secret_key_at_least_32_characters

# ------------------------------------------------------------------------------
# DeHost Cloud & Database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEHOST_URL=https://your-dehost-instance.example.com
NEXT_PUBLIC_DEHOST_ANON_KEY=your_dehost_anon_key
DEHOST_SERVICE_ROLE_KEY=your_dehost_service_role_key
DEHOST_TOKEN=your_dehost_token
DEHOST_OIDC_TOKEN=your_dehost_oidc_token

# ------------------------------------------------------------------------------
# AI Provider Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
NVIDIA_NGC_API_KEY=your_nvidia_ngc_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
MISTRAL_API_KEY=your_mistral_api_key

# ------------------------------------------------------------------------------
# Redis Cache (Upstash)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ------------------------------------------------------------------------------
# Email & Newsletter (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
UNSUBSCRIBE_SALT=your_secure_salt_for_unsubscribes

# ------------------------------------------------------------------------------
# OAuth & Google Services
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# Sentry & Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# Cron Security
# ------------------------------------------------------------------------------
CRON_SECRET=your_cron_job_secret
