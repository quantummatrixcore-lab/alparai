{
  "manifest_version": 3,
  "name": "ALPAR AI - AI Incident Reporter",
  "version": "1.0.0",
  "description": "Detect and report AI failures. See incidents logged on ALPAR AI for the site you're visiting.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://alparai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
