#!/usr/bin/env sh

echo "[pre-push] Running quality checks before push..."

# Fetch upstream branch to compare against
UPSTREAM_BRANCH=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)

if [ -z "$UPSTREAM_BRANCH" ]; then
  echo "[pre-push] No upstream branch found. Running full test suite..."
  pnpm typecheck && pnpm lint && pnpm test
  exit $?
fi

CHANGED_FILES=$(git diff --name-only $UPSTREAM_BRANCH...HEAD 2>/dev/null)
if [ $? -ne 0 ]; then
  echo "[pre-push] Error getting diff. Running full test suite..."
  pnpm typecheck && pnpm lint && pnpm test
  exit $?
fi

if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

ONLY_DOCS=1
for FILE in $CHANGED_FILES; do
  case "$FILE" in
    *.md)
      ;;
    *)
      ONLY_DOCS=0
      break
      ;;
  esac
done

if [ $ONLY_DOCS -eq 0 ]; then
  echo "[pre-push] Code changes detected. Running full test suite..."
  pnpm typecheck && pnpm lint && pnpm test
else
  echo "[pre-push] Only markdown/docs changes detected. Running document checks..."
  node scripts/check-master-plan-length.mjs && node scripts/check-masterplan-consistency.mjs
fi
